name: naive_consumption

uv_env: pyproject.toml

target: consumption
domain: health_supply
required_covariates:
  - stock_on_hand
supported_period_type: month

meta_data:
  display_name: AMC baseline (naive consumption)
  description: >
    Average Monthly Consumption (AMC) baseline, the method many logistics management systems use
    for ordering: Poisson samples around the mean of the last 6 recorded months. Months that ended
    with zero stock on hand are excluded, because consumption in a stock-out month understates
    demand. Intended as the reference other consumption models should beat; its intervals are too
    narrow for inventory decisions.
  author: CHAP health_supply PoC
  author_assessed_status: red

entry_points:
  train:
    parameters:
      train_data: str
      model: str
    command: "python train.py {train_data} {model}"
  predict:
    parameters:
      historic_data: str
      future_data: str
      model: str
      out_file: str
    command: "python predict.py {model} {historic_data} {future_data} {out_file}"
